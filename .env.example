POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# There is no register form, so this is how the first (admin) user gets
# into a fresh database. Created automatically on backend startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- Set these to how users actually reach this server (its LAN/public ---
# --- hostname or IP), not localhost, once it isn't on your own laptop. ---
#
# VITE_API_BASE_URL is baked into the frontend's built JS at image-build
# time (see scripts/offline/build-images.sh) — it cannot be changed later
# by editing .env on the server; the image must be rebuilt.
VITE_API_BASE_URL=http://localhost:8000
# CORS_ORIGINS is read by the backend at container start, so it CAN be
# changed on the server without a rebuild — but it must match the origin
# above (scheme + host + port) or the browser's requests will be blocked.
CORS_ORIGINS=["http://localhost:5173"]
# true only if this is served over HTTPS (e.g. behind a TLS-terminating
# reverse proxy); false for plain HTTP on an internal network.
COOKIE_SECURE=false
