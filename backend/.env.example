DATABASE_URL=postgresql+psycopg2://rf_app:CHANGE_ME@localhost:5432/rf_emitter_db
# The backend refuses to start with this placeholder: generate one with `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=480

BACKUP_DIR=/var/backups/rf-emitter-db
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6
BACKUP_SCHEDULE_DAY=sun
BACKUP_SCHEDULE_TIME=03:00
BACKUP_CHANGES_PER_WEEK=50

# Optional: a language model behind an OpenAI-compatible API (e.g. vLLM), to
# explain ambiguity findings. Unset, the AI buttons don't show.
# LLM_BASE_URL=http://vllm-host:8000/v1
# LLM_MODEL=
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_TOKENS=1200

# Optional: an Outline wiki whose pages the model may be given as background.
# The token's Outline account decides what can be read.
# OUTLINE_URL=https://outline.app
# OUTLINE_API_TOKEN=
# What to read: one page and everything under it (its address from the browser) ...
# OUTLINE_ROOT=https://outline.app/doc/prs-AbC123xyz
# ... or a whole collection:
# OUTLINE_COLLECTION=Group 1
# OUTLINE_CA_BUNDLE=/path/to/your-ca.pem   # only for a certificate from your own CA
# Reaching Outline's container directly on a shared Docker network instead:
# OUTLINE_URL=http://outline:3000
# OUTLINE_PUBLIC_URL=https://outline.app   # the address people open, for links
# How much documentation goes with each question (the relevant sections, or
# all of it if it fits), and how old the app's copy may get before it's
# refreshed from Outline:
# OUTLINE_CONTEXT_TOKENS=6000
# OUTLINE_SYNC_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]
# Must be true in any real deployment; false only for local dev over plain HTTP.
COOKIE_SECURE=true

# Local development only: relaxes the JWT_SECRET check and serves /docs.
# APP_ENV=dev
