DATABASE_URL=postgresql+psycopg2://rf_app:CHANGE_ME@localhost:5432/rf_emitter_db
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=480

BACKUP_DIR=/var/backups/rf-emitter-db
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6

CORS_ORIGINS=["http://localhost:5173"]
# Must be true in any real deployment; false only for local dev over plain HTTP.
COOKIE_SECURE=true
